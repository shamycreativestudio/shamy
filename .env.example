# Vercel Serverless - Variables de entorno

# URL pública del sitio (metadataBase, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Notion API (solo API legacy)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (solo API legacy)
CLOUDINARY_CLOUD_NAME=tu-cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxx

# Admin (Basic Auth para /api/briefs — solo API legacy)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esto_por_una_contraseña_larga_y_unica
